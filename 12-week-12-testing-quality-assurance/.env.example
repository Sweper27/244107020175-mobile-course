# ============================================================
# Campus Notification - Template Konfigurasi Environment (JS 12)
# ------------------------------------------------------------
# Salin file ini menjadi `.env` di root project, lalu isi nilainya.
# File `.env` sudah tercantum pada `.gitignore` sehingga tidak ikut
# ter-commit. Jangan pernah menuliskan credential asli pada file ini.
# ============================================================

# Base URL API backend aplikasi (tanpa garis miring di akhir).
# Bila dikosongkan, aplikasi memakai nilai default pada EnvConfig.
API_BASE_URL=https://mock-api.example.com

# API Key Google Gemini.
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Nama model Gemini yang digunakan oleh fitur AI Assistant.
GEMINI_MODEL=gemini-3.8-flash
